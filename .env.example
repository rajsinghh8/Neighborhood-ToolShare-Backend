APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=mysql+aiomysql://eventforge:eventforge@localhost:3306/eventforge
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUDIT_TOPIC=eventforge.audit
KAFKA_NOTIFICATION_TOPIC=eventforge.notifications
KAFKA_CONSUMER_GROUP=eventforge-app
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
SEED_DEMO_DATA=false
LOG_LEVEL=INFO
