# Must be at least 32 characters.
JWT_SECRET=change-me-change-me-change-me-change-me-0123456789
JWT_ACCESS_EXPIRY_MINUTES=120
JWT_REFRESH_EXPIRY_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
